#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

failures=0
warnings=0

check_command() {
  local command_name="$1"
  if command -v "$command_name" >/dev/null 2>&1; then
    printf 'OK    %-12s %s\n' "$command_name" "$(command -v "$command_name")"
  else
    printf 'FAIL  %-12s missing\n' "$command_name"
    failures=$((failures + 1))
  fi
}

for command_name in grok python3 git jq node npm; do
  check_command "$command_name"
done

if [[ -d "$HOME/.grok" ]]; then
  log "OK    Grok home    $HOME/.grok"
else
  log "FAIL  Grok home    $HOME/.grok is missing"
  failures=$((failures + 1))
fi

if [[ -f "$HOME/.grok/auth.json" ]]; then
  log "OK    Grok auth    ~/.grok/auth.json"
else
  log "FAIL  Grok auth    ~/.grok/auth.json is missing; authenticate Grok first"
  failures=$((failures + 1))
fi

case ":$PATH:" in
  *":$HOME/.local/bin:"*) log "OK    PATH         ~/.local/bin" ;;
  *)
    log "WARN  PATH         add ~/.local/bin before running Paseo"
    warnings=$((warnings + 1))
    ;;
esac

paseo_checkout="${PASEO_REPO_DIR:-$HOME/projects/supervisors/paseo-grok-room}"
if [[ -d "$paseo_checkout/.git" ]]; then
  log "OK    Paseo source $paseo_checkout"
  log "INFO  branch       $(git -C "$paseo_checkout" branch --show-current)"
  log "INFO  commit       $(git -C "$paseo_checkout" rev-parse --short HEAD)"
  origin_url=$(git -C "$paseo_checkout" remote get-url origin 2>/dev/null || true)
  if [[ "$origin_url" == "git@github.com:getpaseo/paseo.git" || "$origin_url" == "https://github.com/getpaseo/paseo.git" ]]; then
    log "OK    upstream     $origin_url"
  else
    log "FAIL  upstream     expected getpaseo/paseo, found ${origin_url:-none}"
    failures=$((failures + 1))
  fi
else
  log "WARN  Paseo source official checkout not found at $paseo_checkout; run scripts/install-paseo-fork"
  warnings=$((warnings + 1))
fi

log ""
if [[ "$failures" -gt 0 ]]; then
  die "$failures required check(s) failed; $warnings warning(s)"
fi
log "DOCTOR_OK: $warnings warning(s)"
