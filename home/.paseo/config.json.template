{
  "version": 1,
  "daemon": {
    "listen": "127.0.0.1:6767",
    "mcp": {
      "injectIntoAgents": true,
      "enabled": true
    },
    "browserTools": {
      "enabled": false
    },
    "autoArchiveAfterMerge": false,
    "enableTerminalAgentHooks": false,
    "appendSystemPrompt": "",
    "terminalProfiles": [
      {
        "id": "grok",
        "name": "Grok",
        "command": "grok",
        "icon": "grok"
      }
    ],
    "agentProfiles": [
      {
        "id": "local-writer",
        "name": "Grok Peer",
        "icon": "grok",
        "color": "blue",
        "provider": "grok-peer",
        "model": "grok-4.6",
        "thinkingOptionId": "high",
        "notes": "Bounded implementation owner. This seat cannot create or coordinate agents."
      },
      {
        "id": "review-fast",
        "name": "Grok Review FAST",
        "icon": "grok",
        "color": "yellow",
        "provider": "grok-review",
        "model": "grok-4.6",
        "thinkingOptionId": "medium",
        "notes": "One bounded FAST review pass. Read-only and unable to create or coordinate agents."
      }
    ],
    "cors": {
      "allowedOrigins": [
        "https://app.paseo.sh"
      ]
    },
    "relay": {
      "enabled": true
    }
  },
  "app": {
    "baseUrl": "https://app.paseo.sh"
  },
  "agents": {
    "providers": {
      "grok-supervisor": {
        "extends": "acp",
        "label": "Grok Supervisor",
        "description": "Portfolio governance seat with Paseo orchestration tools",
        "command": [
          "@@HOME@@/.local/bin/grok-room",
          "supervisor"
        ],
        "paseoTools": {
          "enabled": true
        },
        "models": [
          {
            "id": "grok-4.6",
            "label": "Grok 4.6 High",
            "isDefault": true,
            "thinkingOptions": [
              { "id": "low", "label": "Low" },
              { "id": "medium", "label": "Medium" },
              { "id": "high", "label": "High", "isDefault": true }
            ]
          }
        ]
      },
      "grok-lead": {
        "extends": "acp",
        "label": "Grok Lead",
        "description": "Project technical authority with Paseo orchestration tools",
        "command": [
          "@@HOME@@/.local/bin/grok-room",
          "lead"
        ],
        "paseoTools": {
          "enabled": true
        },
        "models": [
          {
            "id": "grok-4.6",
            "label": "Grok 4.6 High",
            "isDefault": true,
            "thinkingOptions": [
              { "id": "low", "label": "Low" },
              { "id": "medium", "label": "Medium" },
              { "id": "high", "label": "High", "isDefault": true }
            ]
          }
        ]
      },
      "grok-peer": {
        "extends": "acp",
        "label": "Grok Peer",
        "description": "Bounded engineering seat without Paseo orchestration tools",
        "command": [
          "@@HOME@@/.local/bin/grok-room",
          "peer"
        ],
        "paseoTools": {
          "enabled": false
        },
        "models": [
          {
            "id": "grok-4.6",
            "label": "Grok 4.6 High",
            "isDefault": true,
            "thinkingOptions": [
              { "id": "low", "label": "Low" },
              { "id": "medium", "label": "Medium" },
              { "id": "high", "label": "High", "isDefault": true }
            ]
          }
        ]
      },
      "grok-review": {
        "extends": "acp",
        "label": "Grok Review FAST",
        "description": "Read-only bounded FAST reviewer without Paseo orchestration tools",
        "command": [
          "@@HOME@@/.local/bin/grok-room",
          "review"
        ],
        "paseoTools": {
          "enabled": false
        },
        "models": [
          {
            "id": "grok-4.6",
            "label": "Grok 4.6 Medium",
            "isDefault": true,
            "thinkingOptions": [
              { "id": "low", "label": "Low" },
              { "id": "medium", "label": "Medium", "isDefault": true },
              { "id": "high", "label": "High" }
            ]
          }
        ]
      },
      "claude": {
        "enabled": false
      },
      "codex": {
        "enabled": false
      },
      "copilot": {
        "enabled": false
      },
      "opencode": {
        "enabled": false
      },
      "pi": {
        "enabled": false
      },
      "omp": {
        "enabled": false
      }
    }
  },
  "features": {
    "dictation": {
      "enabled": false
    },
    "voiceMode": {
      "enabled": false
    }
  }
}
